rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Bukti transfer: hanya pemilik kavling yang boleh upload ke folder miliknya sendiri.
    // Semua warga yang sudah login boleh melihat (untuk transparansi verifikasi).
    match /buktiTransfer/{noKavling}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email.split('@')[0] == noKavling
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
